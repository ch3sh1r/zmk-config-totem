//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define FNN  1
#define NAV  2
#define GAME 3
#define GANN 4

// Key-position groups for positional hold-tap (home-row mods).
// Positions follow the matrix transform: row0 0-9, row1 10-19,
// row2 20-31 (20 and 31 are the outer columns), thumbs 32-37.
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25   // left hand
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31   // right hand
#define THUMBS 32 33 34 35 36 37                             // all thumbs

/ {
    behaviors {
        // Positional home-row mods: a mod only triggers when a key on the
        // opposite hand (or a thumb) is pressed, which suppresses misfires
        // during same-hand rolls. require-prior-idle-ms suppresses the mod
        // immediately after typing for fast, reliable taps.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    macros {
        ZMK_MACRO(alt_shift,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_press &kp LSHFT>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LALT>
                ;
        )
    };

    combos {
        compatible = "zmk,combos";

        combo_term_copy {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            key-positions = <21 23>;
            bindings = <&kp LC(LS(C))>;
            layers = <0>;
        };

        combo_term_paste {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            key-positions = <21 24>;
            bindings = <&kp LC(LS(V))>;
            layers = <0>;
        };

        combo_parentheses_left {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <13 12>;
            layers = <0>;
        };

        combo_parentheses_right {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <0>;
        };

        combo_bracket_left {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
            layers = <0>;
        };

        combo_bracket_right {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 6>;
            layers = <0>;
        };

        combo_brace_left {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp LEFT_BRACE>;
            key-positions = <23 24>;
            layers = <0>;
        };

        combo_brace_right {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <27 28>;
            layers = <0>;
        };

        combo_caret {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp CARET>;
            key-positions = <17 18>;
            layers = <0>;
        };

        combo_grave {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp GRAVE>;
            key-positions = <12 11>;
            layers = <0>;
        };

        combo_less_than {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp LESS_THAN>;
            key-positions = <1 2>;
            layers = <0>;
        };

        combo_bigger_than {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp GREATER_THAN>;
            key-positions = <7 8>;
            layers = <0>;
        };

        combo_hyphen {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp MINUS>;
            key-positions = <24 27>;
            layers = <0>;
        };

        combo_plus {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp PLUS>;
            key-positions = <3 6>;
            layers = <0>;
        };

        combo_equal {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp EQUAL>;
            key-positions = <13 16>;
            layers = <0>;
        };

        combo_pipe {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp PIPE>;
            key-positions = <23 22>;
            layers = <0>;
        };

        combo_astrsk {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp ASTERISK>;
            key-positions = <2 7>;
            layers = <0>;
        };

        combo_dollar {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp DOLLAR>;
            key-positions = <12 17>;
            layers = <0>;
        };

        combo_hash {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp HASH>;
            key-positions = <28 29>;
            layers = <0>;
        };

        combo_percent {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp PERCENT>;
            key-positions = <23 28>;
            layers = <0>;
        };

        combo_ampersand {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp AMPERSAND>;
            key-positions = <14 15>;
            layers = <0>;
        };

        combo_underscore {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp UNDERSCORE>;
            key-positions = <25 26>;
            layers = <0>;
        };

        combo_backslash {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp BACKSLASH>;
            key-positions = <18 19>;
            layers = <0>;
        };

        combo_tilde {
            require-prior-idle-ms = <100>;
            timeout-ms = <40>;
            bindings = <&kp TILDE>;
            key-positions = <11 10>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
         &kp Q       &kp W       &kp E        &kp R         &kp T      &kp Y         &kp U         &kp I        &kp O       &kp P
         &kp A       &hml LALT S &hml LCTRL D &hml LSHIFT F &kp G      &kp H         &hmr RSHFT J  &hmr RCTRL K &hmr RALT L &kp SEMI
&kp ESC  &kp Z       &kp X       &kp C        &kp V         &kp B      &kp N         &kp M         &kp COMMA    &kp DOT     &kp FSLH  &kp SQT
                                 &kp LMETA    &lt FNN TAB   &kp SPACE  &kp ENTER     &lt NAV BSPC  &kp RMETA
            >;
        };

        fnn {
            bindings = <
        &kp N1     &kp N2     &kp N3     &kp N4     &kp N5      &kp N6  &kp N7   &kp N8   &kp N9  &kp N0
        &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &alt_shift  &kp F1  &kp F2   &kp F3   &kp F4  &kp F5
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp PSCRN   &kp F6  &kp F7   &kp F8   &kp F9  &kp F10  &kp F11
                              &trans     &trans     &trans      &trans  &kp DEL  &kp F12
            >;
        };

        nav {
            bindings = <
            &trans        &trans        &trans        &kp C_BRI_UP   &kp C_BRI_DN  &kp C_VOL_UP  &kp C_VOL_DN  &kp C_PREV  &kp C_PP   &kp C_NEXT
            &trans        &trans        &trans        &trans         &trans        &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4  &kp PG_UP     &kp PG_DN     &kp HOME    &kp END    &trans      &trans
                                        &trans        &trans         &trans        &tog GAME     &trans        &trans
            >;
        };

        game {
            bindings = <
          &kp T           &kp Q  &kp W       &kp E    &kp R      &trans    &trans  &trans  &trans  &trans
          &kp LEFT_SHIFT  &kp A  &kp S       &kp D    &kp F      &trans    &trans  &trans  &trans  &trans
&kp ESC   &kp LCTRL       &kp Z  &kp X       &kp C    &kp V      &trans    &trans  &trans  &trans  &trans  &trans
                                 &lt GANN I  &kp TAB  &kp SPACE  &to BASE  &trans  &trans
            >;
        };

        game_fnn {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &trans  &trans  &trans
&kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

